# Database
DATABASE_URL=postgresql://postgres@localhost:5432/solarflow

# Authentication
JWT_SECRET=change-this-to-a-real-secret

# Application
APP_ENV=development
DEBUG=true

# CORS (comma-separated frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Weather API (free, no key needed)
WEATHER_BASE_URL=https://api.open-meteo.com/v1

# EPİAŞ Transparency Platform — free account at seffaflik.epias.com.tr
# (needed for PTF/day-ahead price data)
EPIAS_USERNAME=
EPIAS_PASSWORD=

# Demo mode: keep feeding synthetic telemetry to the seeded demo factory
# (python scripts/seed_demo_site.py). Leave false with real devices.
DEMO_TELEMETRY_ENABLED=false

# Email (optional — sign up at https://resend.com)
RESEND_API_KEY=
FROM_EMAIL=SolarFlow <noreply@solarflow.io>

# AI — Grok/xAI (optional — sign up at https://console.x.ai)
XAI_API_KEY=
