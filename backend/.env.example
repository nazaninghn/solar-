APP_NAME=SolarFlow API
APP_ENV=development
DEBUG=true

# Render's managed Postgres gives you a postgres:// or postgresql://
# connection string — paste it in as-is, app/core/config.py normalizes
# the scheme to postgresql+psycopg:// automatically.
DATABASE_URL=postgresql+psycopg://solarflow:solarflow_password@db:5432/solarflow

JWT_SECRET=change-this-in-production
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=60
EMAIL_VERIFICATION_EXPIRE_HOURS=24

WEATHER_API_KEY=
WEATHER_BASE_URL=

# Comma-separated, no trailing slash, no wildcard in production —
# e.g. https://app.solarflow.com,https://staging.solarflow.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# "text" for a readable local terminal, "json" for a production log
# aggregator to parse.
LOG_FORMAT=text

# Logs a warning for any query slower than this many milliseconds.
SLOW_QUERY_THRESHOLD_MS=1000

# Leave empty to keep error tracking inert (no Sentry account needed to
# run this project). Set to a real Sentry DSN to enable it.
SENTRY_DSN=

# Only required once a real device protocol adapter starts storing
# connection credentials (Modbus/MQTT/REST — all inert stubs today).
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTION_CONFIG_ENCRYPTION_KEY=
